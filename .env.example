PORT=4000
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow

# Jira Cloud REST API v3
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_JQL_QUERY=updated >= -20m ORDER BY updated ASC

# GitHub REST API v3 — a fine-grained PAT with read access (write scopes only if you'll use
# Create Issue/Branch/PR) to GITHUB_OWNER/GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
