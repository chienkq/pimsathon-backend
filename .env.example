PORT=4000
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow

# JQL is still a workflow parameter, not a credential — Jira's connection (site URL/email/API token)
# is configured from admin-ui's Settings → Integrations screen instead, like GitHub below.
JIRA_JQL_QUERY=updated >= -20m ORDER BY updated ASC

# Jira and GitHub are no longer configured via env vars — connect them from admin-ui's Settings →
# Integrations screen instead, which the W1 Jira Sync / W3 GitHub Sync workflows now read from the
# encrypted `credentials` table on every scheduled run.

# Integrations screen (W6) — encrypts Jira/Slack/Teams/Outlook/Gmail/GitHub credentials stored in the
# `credentials` table. Generate with `openssl rand -hex 32`. Falls back to an insecure dev-only key if unset.
CREDENTIALS_ENCRYPTION_KEY=
